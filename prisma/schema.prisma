generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  userId         String    @id
  displayName    String
  points         Int       @default(0)
  nextRank       String    @default("regular")
  lastCheckInAt  DateTime?
  officialAccountId String?
  officialLinkedAt DateTime?
  surveyId       String?   @unique
  rank           Rank      @relation(fields: [nextRank], references: [id])
  officialAccount OfficialAccount? @relation(fields: [officialAccountId], references: [id])
  survey         UserSurvey? @relation(fields: [surveyId], references: [id])
  checkIns       UserCheckIn[]
  histories      UserHistory[]
  userGifts      UserGift[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("users")
}

model UserSurvey {
  id                 String   @id @default(cuid())
  gender             String
  visitFrequency     String
  companionType      String
  birthDate          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  users              User[]

  @@map("user_surveys")
}

enum GiftExpiryType {
  DAYS_AFTER_ISSUE
  FIXED_DATE
}

model Gift {
  id            String         @id @default(cuid())
  title         String
  usageGuide    String
  expiryType    GiftExpiryType
  expiryDays    Int?
  expiryAt      DateTime?
  imageUrl      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userGifts     UserGift[]
  visitGachaSettings VisitGachaSetting[]

  @@map("gifts")
}

model VisitGachaSetting {
  id                String           @id @default(cuid())
  scopeKey          String           @unique
  officialAccountId String?
  giftId            String
  winProbability    Int
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  officialAccount   OfficialAccount? @relation(fields: [officialAccountId], references: [id])
  gift              Gift             @relation(fields: [giftId], references: [id], onDelete: Cascade)
  rankProbabilities VisitGachaRankProbability[]

  @@index([officialAccountId])
  @@index([giftId])
  @@map("visit_gacha_settings")
}

model VisitGachaRankProbability {
  id         String           @id @default(cuid())
  settingId  String
  rankId     String
  winProbability Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  setting    VisitGachaSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  rank       Rank             @relation(fields: [rankId], references: [id], onDelete: Cascade)

  @@unique([settingId, rankId])
  @@index([rankId])
  @@map("visit_gacha_rank_probabilities")
}

model GiftImageTemplate {
  id         String   @id @default(cuid())
  name       String
  imageUrl   String
  sortOrder  Int      @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("gift_image_templates")
}

model UserGift {
  id                   String    @id @default(cuid())
  userId               String
  giftId               String
  isUsed               Boolean   @default(false)
  usedAt               DateTime?
  issuedAt             DateTime  @default(now())
  expiresAt            DateTime
  transferredFromId    String?
  transferredToUserId  String?
  transferredAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  gift                 Gift      @relation(fields: [giftId], references: [id], onDelete: Cascade)
  transferredFrom      UserGift? @relation("GiftTransfer", fields: [transferredFromId], references: [id], onDelete: SetNull)
  transferredTo        UserGift[] @relation("GiftTransfer")

  @@index([userId, isUsed])
  @@index([giftId])
  @@index([expiresAt])
  @@map("user_gifts")
}

model Rank {
  id        String @id
  name      String
  minPoints Int
  maxPoints Int
  users     User[]
  visitGachaRankProbabilities VisitGachaRankProbability[]

  @@map("ranks")
}

model AdminUser {
  id           String   @id
  passwordHash String
  officialAccountId String?
  officialAccount OfficialAccount? @relation(fields: [officialAccountId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_user")
}

model OfficialAccount {
  id            String      @id @default(cuid())
  lineBasicId   String      @unique
  name          String?
  users         User[]
  adminUsers    AdminUser[]
  userHistories UserHistory[]
  checkIns      UserCheckIn[]
  visitGachaSettings VisitGachaSetting[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("official_accounts")
}

model UserCheckIn {
  id                String           @id @default(cuid())
  userId            String
  checkedInAt       DateTime
  isFirstVisit      Boolean
  isRepeatVisit     Boolean
  officialAccountId String?
  user              User             @relation(fields: [userId], references: [userId], onDelete: Cascade)
  officialAccount   OfficialAccount? @relation(fields: [officialAccountId], references: [id])
  createdAt         DateTime         @default(now())

  @@index([userId, checkedInAt])
  @@index([checkedInAt])
  @@map("user_checkins")
}

model UserHistory {
  id                String           @id @default(cuid())
  targetUserId      String
  actorType         String
  actorId           String?
  action            String
  metadata          Json?
  officialAccountId String?
  targetUser        User             @relation(fields: [targetUserId], references: [userId], onDelete: Cascade)
  officialAccount   OfficialAccount? @relation(fields: [officialAccountId], references: [id])
  createdAt         DateTime         @default(now())

  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@map("user_history")
}

model AdminAuthUser {
  id            String             @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  username      String?            @unique
  displayUsername String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  sessions      AdminAuthSession[]
  accounts      AdminAuthAccount[]

  @@unique([email])
  @@map("admin_auth_user")
}

model AdminAuthSession {
  id        String        @id
  expiresAt DateTime
  token     String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AdminAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_auth_session")
}

model AdminAuthAccount {
  id                    String        @id
  accountId             String
  providerId            String
  userId                String
  user                  AdminAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@map("admin_auth_account")
}

model AdminAuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("admin_auth_verification")
}
